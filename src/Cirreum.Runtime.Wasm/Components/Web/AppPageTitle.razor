@namespace Cirreum.Components.Web
@inject IBrowserDocumentState DocumentState

<PageTitle>@FinalContent</PageTitle>

@code {

	[Parameter, EditorRequired]
	public RenderFragment ChildContent { get; set; } = default!;

	RenderFragment FinalContent = default!;

	protected override void OnInitialized() {
		base.OnInitialized();
		if (DocumentState.IsStandAlone) {
			FinalContent = ChildContent;
		} else {
			FinalContent = __builder => {
				if (DocumentState.DocumentTitlePrefix.HasValue()){
					__builder.AddContent(0, DocumentState.DocumentTitlePrefix);
					__builder.AddContent(1, $" {DocumentState.DocumentTitleSeparator} ");
				}
				__builder.AddContent(2, ChildContent);
				if (DocumentState.DocumentTitleSuffix.HasValue()) {
					__builder.AddContent(3, $" {DocumentState.DocumentTitleSeparator} ");
					__builder.AddContent(4, DocumentState.DocumentTitleSuffix);
				}
			};
		}
	}

}