# Cirreum framework CSP baseline for Blazor WebAssembly.
#
# This baseline always applies. The app's Properties\csp.policy and any
# Properties\csp.{Env}.policy overlay merge on top of it, and source lists are
# unioned - an app policy adds sources to a directive, it does not replace them.
# Set CirreumGenerateCsp=false in the project to emit no policy at all.
#
# The baseline permits same-origin resources, plus the one external host the
# framework's own loader fetches from (fonts.cdnfonts.com, see style-src and
# font-src below). Anything else cross-origin an app needs - its API, a CDN, an
# analytics endpoint - belongs in the app's own csp.policy.
#
# Additions in an app or environment policy that materially widen the posture
# (unsafe keywords on script-src, wildcards, object-src, base-uri, default-src,
# third-party script origins) raise a CSP00xx build warning. The build does not
# fail; the warning names the file and directive so the decision is visible.

base-uri 'self';
default-src 'self';
frame-ancestors 'self';

# Blocks <object>, <embed> and <applet>, which Blazor never needs. An app policy
# adding sources here replaces the 'none': the generator removes it from the merged
# directive (a list containing 'none' alongside other values ignores it anyway) and
# warns that the directive was widened.
object-src 'none';

# 'data:' covers inline images and icons emitted by the Blazor templates and by most
# component libraries. Remote image hosts belong in the app's csp.policy.
img-src 'self' data:;

# Declared explicitly although default-src 'self' would cover it. A fetch directive
# that is absent falls back to default-src; one that is present replaces it entirely.
# Every app adds its API origin to connect-src, and without 'self' here that addition
# would stand alone and block the runtime's own same-origin fetches of _framework/*
# (blazor.boot.json, dotnet.*.wasm, the assembly bundles), so nothing would start.
connect-src 'self';

# 'wasm-unsafe-eval' is required by the Blazor Mono runtime to instantiate the
# WebAssembly module. It is narrower than 'unsafe-eval': it permits WebAssembly
# compilation only, not eval() of JavaScript.
script-src 'self' 'wasm-unsafe-eval';

# 'unsafe-inline' covers inline style ATTRIBUTES (style="..."), which the Blazor
# templates and most component libraries emit for layout and visibility. Style
# attributes cannot be allowed by hash or nonce, so there is no stricter equivalent
# short of eliminating every inline style in the app and its component libraries.
# Scoped component CSS does NOT require it: .razor.css compiles into the external
# {Assembly}.styles.css bundle, which 'self' already covers.
# fonts.cdnfonts.com is where the framework loader (cirreum-wasm-loader.js) fetches a
# configured font from, so it is permitted here rather than in every app's policy.
style-src 'self' 'unsafe-inline' https://fonts.cdnfonts.com;

font-src 'self' https://fonts.cdnfonts.com;

# Upgrades http:// subresource requests to https://. Applies to the deployed
# Static Web App only; the generated config is not used by local development.
upgrade-insecure-requests;
